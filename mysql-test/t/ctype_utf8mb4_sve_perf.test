ORDER BY EVENT_ID DESC LIMIT 1;

SET @order_auto_med := (
  SELECT CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(GROUP_CONCAT(timer_wait ORDER BY timer_wait), ',', 3), ',', -1) AS UNSIGNED)
  FROM t_sve_perf_sql WHERE kind='order' AND mode='auto'
);
SET @order_scalar_med := (
  SELECT CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(GROUP_CONCAT(timer_wait ORDER BY timer_wait), ',', 3), ',', -1) AS UNSIGNED)
  FROM t_sve_perf_sql WHERE kind='order' AND mode='force_scalar'
);
SET @group_auto_med := (
  SELECT CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(GROUP_CONCAT(timer_wait ORDER BY timer_wait), ',', 3), ',', -1) AS UNSIGNED)
  FROM t_sve_perf_sql WHERE kind='group' AND mode='auto'
);
SET @group_scalar_med := (
  SELECT CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(GROUP_CONCAT(timer_wait ORDER BY timer_wait), ',', 3), ',', -1) AS UNSIGNED)
  FROM t_sve_perf_sql WHERE kind='group' AND mode='force_scalar'
);
SET @like_auto_med := (
  SELECT CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(GROUP_CONCAT(timer_wait ORDER BY timer_wait), ',', 3), ',', -1) AS UNSIGNED)
  FROM t_sve_perf_sql WHERE kind='like' AND mode='auto'
);
SET @like_scalar_med := (
  SELECT CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(GROUP_CONCAT(timer_wait ORDER BY timer_wait), ',', 3), ',', -1) AS UNSIGNED)
  FROM t_sve_perf_sql WHERE kind='like' AND mode='force_scalar'
);

if ($sve_available)
{
  SELECT @order_auto_med > 0 AND @order_scalar_med > 0 AS order_timing_collected;
  SELECT @group_auto_med > 0 AND @group_scalar_med > 0 AS group_timing_collected;
  SELECT @like_auto_med > 0 AND @like_scalar_med > 0 AS like_timing_collected;
}
if (!$sve_available)
{
  SELECT IF(@order_auto_med >= @order_scalar_med,
            @order_auto_med - @order_scalar_med,
            @order_scalar_med - @order_auto_med) <= GREATEST(@order_scalar_med * 0.10, 1) AS order_fallback_close;
  SELECT IF(@group_auto_med >= @group_scalar_med,
            @group_auto_med - @group_scalar_med,
            @group_scalar_med - @group_auto_med) <= GREATEST(@group_scalar_med * 0.10, 1) AS group_fallback_close;
  SELECT IF(@like_auto_med >= @like_scalar_med,
            @like_auto_med - @like_scalar_med,
            @like_scalar_med - @like_auto_med) <= GREATEST(@like_scalar_med * 0.10, 1) AS like_fallback_close;
  SELECT CONVERT(test_sve_metrics() USING utf8mb4) LIKE '%fast_calls=0%' AS perf_no_fast;
}

DROP TEMPORARY TABLE t_sve_perf_numchars;
DROP TEMPORARY TABLE t_sve_perf_sql;

--disable_query_log
UPDATE performance_schema.setup_consumers
SET enabled = @save_ps_global
WHERE NAME = 'global_instrumentation';
UPDATE performance_schema.setup_consumers
SET enabled = @save_ps_thread
WHERE NAME = 'thread_instrumentation';
UPDATE performance_schema.setup_consumers
SET enabled = @save_ps_stmt_current
WHERE NAME = 'events_statements_current';
UPDATE performance_schema.setup_consumers
SET enabled = @save_ps_stmt_history_long
WHERE NAME = 'events_statements_history_long';
--enable_query_log

--disable_warnings
DROP TABLE IF EXISTS t_sve_sql;
DROP TABLE IF EXISTS t_sve_mem;
DROP TABLE IF EXISTS t_sve_part;
UNINSTALL COMPONENT "file://component_test_utf8mb4_sve";
--enable_warnings
