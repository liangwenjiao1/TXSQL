# 用例 5f: 明确当前版本不存在 utf8_0900_ai_ci，避免误将其视为 utf8mb3 范围
SELECT COUNT(*) = 0 AS utf8_0900_ai_ci_absent
FROM information_schema.collations
WHERE collation_name = 'utf8_0900_ai_ci';
utf8_0900_ai_ci_absent
1
