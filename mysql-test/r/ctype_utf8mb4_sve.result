INSTALL COMPONENT "file://component_test_utf8mb4_sve";
SET NAMES utf8mb4;
SET @sve_metrics := test_sve_metrics();
SET @sve_available := @sve_metrics REGEXP '(^|;)sve_available=1(;|$)';
SET @sve_instrumented := @sve_metrics REGEXP '(^|;)instrumentation_enabled=1(;|$)';
SET @sve_metric_checks := @sve_available AND @sve_instrumented;
SET @sve_lane := CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(@sve_metrics, 'lane_bytes=', -1), ';', 1) AS UNSIGNED);
SET @sve_len_unit := IF(@sve_lane > 0, @sve_lane, 16);
test_sve_reset()
0
test_sve_mode('auto')
0
# 用例 1: 验证 utf8mb4_general_ci 下纯 ASCII 长串 strnncoll 与标量结果一致
test_sve_reset()
0
test_sve_mode('auto')
0
test_sve_reset()
0
test_sve_mode('force_scalar')
1
SELECT @sve_auto_result <=> @sve_scalar_result AS same_result;
same_result
1
SELECT @sve_scalar_metrics LIKE '%fast_calls=0%' AS scalar_no_fast;
scalar_no_fast
1
SELECT @sve_auto_metrics NOT LIKE '%fast_calls=0%' AS auto_has_fast;
auto_has_fast
1
SELECT @sve_auto_metrics LIKE '%tail_bytes=0%' AS no_tail;
no_tail
0
# 用例 2: 验证 utf8mb4_general_ci 下 strcasecmp 大小写折叠与标量一致
test_sve_reset()
0
test_sve_mode('auto')
0
test_sve_reset()
0
test_sve_mode('force_scalar')
1
SELECT @sve_auto_result <=> @sve_scalar_result AS same_result;
same_result
1
SELECT @sve_scalar_metrics LIKE '%fast_calls=0%' AS scalar_no_fast;
scalar_no_fast
1
SELECT @sve_auto_result = 0 AS casefold_equal;
casefold_equal
1
